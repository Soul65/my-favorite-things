{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"lint:types": {
			"dependsOn": ["^lint:types"]
		},
		"dev": {
			"persistent": true,
			"cache": false
		}
	}
}
